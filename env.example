# Copy to backend/.env and fill later. Never put these values in Flutter.
# Secrets are not returned by the API.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

ETHERSCAN_API_KEY=

REDIS_URL=

WALLETCONNECT_PROJECT_ID=

PUBLIC_RPC_URL=
# Optional per-chain override, for example RPC_URL_84532=https://...
# Each dropdown network already has a default HTTPS RPC.
# Must be a 32-byte 0x key that is NOT the local Anvil demo key.
# Fund it on every network you broadcast to.
DEPLOYER_PRIVATE_KEY=
ALLOW_PUBLIC_BROADCAST=false
ALLOW_MAINNET=false

ORACLE_CLOUD_HOST=
